# Copy this file to .env and fill in the values
# Never commit .env to source control

# Required — the server won't start without this
PORT=3000

# Required — PostgreSQL connection string
# Local:      postgresql://bptracker:bptracker@localhost:5432/bptracker
# Cloud SQL:  postgresql://USER:PASSWORD@/DB?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=postgresql://bptracker:bptracker@localhost:5432/bptracker

# Required — sign JWTs for user sessions (min 32 random characters)
# Generate:   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret

# Optional
NODE_ENV=production
LOG_LEVEL=info
